# Database (Neon Postgres) — pooled connection string
DATABASE_URL=

# Market data
FMP_API_KEY=
FMP_DAILY_LIMIT=250

# News + LLM (used starting SP2)
FINNHUB_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_PREVIEW_MODEL=gemini-3-flash-preview

# SEC (used in SP3) — required contact UA
SEC_USER_AGENT="Kavin Ravi kavinravi121@gmail.com"

# Auth gate (used in SP4) — when both are set the app requires login.
# On Vercel, both MUST be set or the app fails closed. Locally, leave unset for an ungated dev server.
APP_PASSWORD=
SESSION_SECRET=   # a long random string, e.g. `openssl rand -hex 32`
